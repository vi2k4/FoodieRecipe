# Database
DATABASE_URL=postgresql://foodie_user:foodie_password@localhost:5433/foodie_db

# App
PORT=3001
NODE_ENV=development
# Set false for HTTP deployments; set true when the API is served over HTTPS.
COOKIE_SECURE=false

# JWT / auth (optional placeholders)
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

#S3 bucket
AWS_REGION=ap-southeast-1

AWS_ACCESS_KEY_ID=your_access_key

AWS_SECRET_ACCESS_KEY=your_secret_key

AWS_BUCKET_NAME=my-foodie-ai-images
# Email verification (Resend)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=FoodiRecipe <no-reply@your-domain.com>

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
